# ============================================
# images-generate 环境变量配置示例
# ============================================

# 本机访问端口
APP_PORT=8000

# 前端默认密钥（无登录模式会使用；Docker 构建时会写入前端产物）
NEXT_PUBLIC_DEFAULT_AUTH_KEY=your_secret_key_here

# 后端认证密钥（可选，覆盖 config.json）
CHATGPT2API_AUTH_KEY=your_secret_key_here

# 上游图片接口地址
IMAGE_PROXY_BASE_URL=https://generate.muling.store

# AI 润色接口地址（OpenAI 兼容 /v1 地址）
IMAGE_PROMPT_POLISH_BASE_URL=https://api.muling.store/v1

# AI 润色模型
IMAGE_PROMPT_POLISH_MODEL=gpt-5.5

# AI 润色接口密钥
IMAGE_PROMPT_POLISH_API_KEY=your_polish_api_key_here

# 每个公网 IP + 浏览器指纹的额度
IMAGE_PROXY_IP_QUOTA_LIMIT=20

# 后端图片任务 worker 上限，用于控制真实生成并发和线程资源
IP_IMAGE_TASK_MAX_WORKERS=80

# 单个访客/用户最多可同时排队的图片任务数
MAX_OWNER_QUEUED_IMAGE_TASKS=4

# 基础 URL（可选，用于生成图片 URL）
# CHATGPT2API_BASE_URL=https://your-domain.com

# ============================================
# 存储后端配置
# ============================================

# 存储后端类型（可选值: json, sqlite, postgres, git）
# 默认: json
STORAGE_BACKEND=json

# ============================================
# 数据库配置（当 STORAGE_BACKEND=sqlite/postgres 时使用）
# ============================================

# PostgreSQL 示例
# DATABASE_URL=postgresql://user:password@localhost:5432/images_generate

# Supabase 示例
# DATABASE_URL=postgresql://postgres.xxx:password@aws-1-us-west-1.pooler.supabase.com:5432/postgres

# SQLite 示例（不指定时自动使用 data/accounts.db）
# DATABASE_URL=sqlite:///app/data/accounts.db

# ============================================
# Git 仓库配置（当 STORAGE_BACKEND=git 时使用）
# ============================================

# Git 仓库地址（必填）
# GIT_REPO_URL=https://github.com/your-username/your-private-repo.git

# Git 访问令牌（必填）
# GitHub: ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GitLab: glpat-xxxxxxxxxxxxxxxxxxxx
# GIT_TOKEN=your_git_token_here

# Git 分支（可选，默认: main）
# GIT_BRANCH=main

# Git 仓库中的文件路径（可选，默认: accounts.json）
# GIT_FILE_PATH=accounts.json
